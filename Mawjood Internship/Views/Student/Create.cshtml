@model BLogicLayer.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Create Student";
}

<div class="container mw-container py-4">

    <div class="mw-card mw-form">

        <div class="mb-4">
            <span class="mw-eyebrow">STUDENT MANAGEMENT</span>

            <h1 class="mb-2">
                Add Student
            </h1>

            <p class="mw-muted mb-0">
                Create a new student record.
            </p>
        </div>

        <form asp-controller="Student"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="alert alert-danger"
                 role="alert">
            </div>

            <div class="row g-3">

                <!-- First Name -->
                <div class="col-md-6">

                    <label asp-for="FName"
                           class="form-label">
                        First Name
                    </label>

                    <input asp-for="FName"
                           class="form-control mw-input"
                           autocomplete="given-name" />

                    <span asp-validation-for="FName"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Last Name -->
                <div class="col-md-6">

                    <label asp-for="LName"
                           class="form-label">
                        Last Name
                    </label>

                    <input asp-for="LName"
                           class="form-control mw-input"
                           autocomplete="family-name" />

                    <span asp-validation-for="LName"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Email -->
                <div class="col-md-6">

                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control mw-input"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Password -->
                <div class="col-md-6">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control mw-input"
                           autocomplete="new-password"
                           placeholder="Leave empty for temporary password" />

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>

                </div>

                <!-- University -->
                <div class="col-md-6">

                    <label asp-for="University"
                           class="form-label">
                        University
                    </label>

                    <input asp-for="University"
                           class="form-control mw-input" />

                    <span asp-validation-for="University"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Major -->
                <div class="col-md-6">

                    <label asp-for="Major"
                           class="form-label">
                        Major
                    </label>

                    <input asp-for="Major"
                           class="form-control mw-input" />

                    <span asp-validation-for="Major"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Education -->
                <div class="col-md-6">

                    <label asp-for="Education"
                           class="form-label">
                        Education
                    </label>

                    <input asp-for="Education"
                           class="form-control mw-input" />

                    <span asp-validation-for="Education"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Academic Year -->
                <div class="col-md-6">

                    <label asp-for="AcademicYear"
                           class="form-label">
                        Academic Year
                    </label>

                    <input asp-for="AcademicYear"
                           type="number"
                           min="1"
                           max="5"
                           class="form-control mw-input"
                           placeholder="1 - 5" />

                    <span asp-validation-for="AcademicYear"
                          class="text-danger small">
                    </span>

                </div>

                <!-- City -->
                <div class="col-md-6">

                    <label asp-for="City"
                           class="form-label">
                        City
                    </label>

                    <input asp-for="City"
                           class="form-control mw-input" />

                    <span asp-validation-for="City"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Government -->
                <div class="col-md-6">

                    <label asp-for="Government"
                           class="form-label">
                        Government
                    </label>

                    <input asp-for="Government"
                           class="form-control mw-input" />

                    <span asp-validation-for="Government"
                          class="text-danger small">
                    </span>

                </div>

            </div>

            <div class="mw-actions-row mt-4">

                <button type="submit"
                        class="btn mw-btn mw-btn-primary">

                    <span class="material-symbols-outlined">
                        person_add
                    </span>

                    Create Student

                </button>

                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn mw-btn mw-btn-outline">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}