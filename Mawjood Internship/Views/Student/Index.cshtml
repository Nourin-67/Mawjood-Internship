@model List<BLogicLayer.ViewModels.StudentViewModel>
@{
    ViewData["Title"] = "Students";
}

<div class="mw-container mw-section">
    <div class="mw-section-head">
        <div>
            <div class="mw-chip">Admin</div>
            <h2 class="mt-2">Students Management</h2>
            <p>Manage student records using the existing StudentController actions.</p>
        </div>
        <a class="mw-btn mw-btn-primary" asp-action="Create">
            <span class="material-symbols-outlined">person_add</span> Add Student
        </a>
    </div>

    <div class="mw-card mw-table-wrap">
        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">No students found.</div>
        }
        else
        {
            <table class="mw-table">
                <thead>
                    <tr><th>Name</th><th>Email</th><th>University</th><th>Major</th><th>Year</th><th>City</th><th>Actions</th></tr>
                </thead>
                <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td><strong>@student.FName @student.LName</strong></td>
                        <td>@student.Email</td>
                        <td>@(student.University ?? "—")</td>
                        <td>@(student.Major ?? "—")</td>
                        <td>@(student.AcademicYear?.ToString() ?? "—")</td>
                        <td>@(student.City ?? "—")</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a class="mw-btn mw-btn-outline" asp-action="Details" asp-route-id="@student.Id">View</a>
                                <a class="mw-btn mw-btn-outline" asp-action="Edit" asp-route-id="@student.Id">Edit</a>
                                <a class="mw-btn mw-btn-outline" asp-action="Delete" asp-route-id="@student.Id">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
