@model BLogicLayer.ViewModels.StudentViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="mw-container mw-section">
    <div class="mw-section-head">
        <div>
            <div class="mw-chip">Student Portal</div>
            <h2 class="mt-2">My Profile</h2>
            <p>Your profile information from the existing student service.</p>
        </div>
    </div>

    <div class="mw-card mw-profile-header">
        <div class="mw-avatar">@Model.FName.Substring(0,1)@Model.LName.Substring(0,1)</div>
        <div>
            <h1 class="h3 mb-1">@Model.FName @Model.LName</h1>
            <div class="mw-muted">@Model.Email</div>
        </div>
    </div>

    <div class="mw-card mw-card-pad mt-3">
        <h3 class="h5 mb-3">Academic & Personal Details</h3>
        <div class="mw-info-grid">
            <div class="mw-info-item"><div class="mw-info-label">University</div><div class="mw-info-value">@(Model.University ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Major</div><div class="mw-info-value">@(Model.Major ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Education</div><div class="mw-info-value">@(Model.Education ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Academic Year</div><div class="mw-info-value">@(Model.AcademicYear?.ToString() ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">City</div><div class="mw-info-value">@(Model.City ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Government</div><div class="mw-info-value">@(Model.Government ?? "—")</div></div>
        </div>

        <div class="mw-actions-row">
            <a class="mw-btn mw-btn-primary" asp-controller="CV" asp-action="Index">Manage My CV</a>
        </div>
    </div>
</div>
