@model BLogicLayer.ViewModels.CompanyViewModel

@{
    ViewData["Title"] = "Company Details";
}

<div class="container mt-4">

    <h2>Company Details</h2>

    <div class="card p-4">

        <h4>@Model.Name</h4>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>City:</strong>
            @Model.City
        </p>

        <p>
            <strong>Government:</strong>
            @Model.Government
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-secondary mt-3">
        Back
    </a>

</div>