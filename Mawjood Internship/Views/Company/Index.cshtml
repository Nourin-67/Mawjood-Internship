@model List<BLogicLayer.ViewModels.CompanyViewModel>
@{
    ViewData["Title"] = "Companies";
}

<div class="mw-container mw-section">
    <div class="mw-section-head">
        <div>
            <div class="mw-chip">Admin</div>
            <h2 class="mt-2">Companies Management</h2>
            <p>View and manage companies already supported by the backend.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a class="mw-btn mw-btn-primary" asp-action="Create">
                <span class="material-symbols-outlined">add_business</span> Add Company
            </a>
        }
    </div>

    <div class="mw-card mw-table-wrap">
        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">No companies found.</div>
        }
        else
        {
            <table class="mw-table">
                <thead><tr><th>Name</th><th>Email</th><th>City</th><th>Government</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var company in Model)
                {
                    <tr>
                        <td><strong>@company.Name</strong></td>
                        <td>@company.Email</td>
                        <td>@(company.City ?? "—")</td>
                        <td>@(company.Government ?? "—")</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a class="mw-btn mw-btn-outline" asp-action="Details" asp-route-id="@company.Id">View</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="mw-btn mw-btn-outline" asp-action="Edit" asp-route-id="@company.Id">Edit</a>
                                    <a class="mw-btn mw-btn-outline" asp-action="Delete" asp-route-id="@company.Id">Delete</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
