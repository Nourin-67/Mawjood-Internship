@model List<BLogicLayer.ViewModels.CompanyViewModel>

@{
    ViewData["Title"] = "Companies";
}

<div class="mw-container mw-section">

    <!-- Page Header -->
    <div class="mw-section-head">

        <div>
            <div class="mw-chip">
                Admin
            </div>

            <h2 class="mt-2">
                Companies Management
            </h2>

            <p>
                View and manage companies already supported by the backend.
            </p>
        </div>


        <!-- Add Company -->
        @if (User.IsInRole("Admin"))
        {
            <a class="mw-btn mw-btn-primary"
               asp-action="Create">

                <span class="material-symbols-outlined">
                    add_business
                </span>

                Add Company

            </a>
        }

    </div>


    <!-- Companies Table -->
    <div class="mw-card mw-table-wrap">

        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">
                No companies found.
            </div>
        }
        else
        {
            <table class="mw-table">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>Government</th>
                        <th>Actions</th>
                    </tr>
                </thead>


                <tbody>

                    @foreach (var company in Model)
                    {
                        <tr>

                            <!-- Company Name -->
                            <td>
                                <strong>
                                    @company.Name
                                </strong>
                            </td>


                            <!-- Email -->
                            <td>
                                @company.Email
                            </td>


                            <!-- City -->
                            <td>
                                @(company.City ?? "—")
                            </td>


                            <!-- Government -->
                            <td>
                                @(company.Government ?? "—")
                            </td>


                            <!-- Actions -->
                            <td>

                                <div class="d-flex gap-1 flex-wrap">

                                    <!-- View -->
                                    <a class="mw-btn mw-btn-outline"
                                       asp-action="Details"
                                       asp-route-id="@company.Id">

                                        View

                                    </a>


                                    @if (User.IsInRole("Admin"))
                                    {
                                        <!-- Edit -->
                                        <a class="mw-btn mw-btn-outline"
                                           asp-action="Edit"
                                           asp-route-id="@company.Id">

                                            Edit

                                        </a>


                                        <!-- Delete -->
                                        <form asp-action="DeleteConfirmed"
                                              method="post"
                                              asp-route-id="@company.Id"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="mw-btn mw-btn-outline"
                                                    onclick="return confirm('Are you sure you want to delete this company?');">

                                                Delete

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

</div>