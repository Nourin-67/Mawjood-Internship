@model List<BLogicLayer.ViewModels.ApplicationViewModel>

@{
    ViewData["Title"] = "Applications";
}

<div class="mw-container mw-section">

    <div class="mw-section-head">

        <div>
            <div class="mw-chip">Admin</div>

            <h2 class="mt-2">
                Applications Review
            </h2>

            <p>
                Review student applications, matching scores and application status.
            </p>
        </div>

    </div>


    <div class="mw-card mw-table-wrap">

        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">

                <span class="material-symbols-outlined"
                      style="font-size:42px;">
                    inbox
                </span>

                <h3 class="mt-3">
                    No applications found
                </h3>

                <p>
                    There are currently no student applications.
                </p>

            </div>
        }
        else
        {
            <table class="mw-table">

                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th>Internship</th>
                        <th>Matching</th>
                        <th>CV</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var application in Model)
                    {
                        <tr>

                            @* Applicant *@
                            <td>
                                <strong>
                                    @application.StudentName
                                </strong>
                            </td>


                            @* Internship *@
                            <td>
                                @application.InternshipTitle
                            </td>


                            @* Matching Score *@
                            <td>

                                <span class="mw-chip">
                                    @application.MatchingScore.ToString("0")%
                                </span>

                            </td>


                            @* CV *@
                            <td>

                                @if (!string.IsNullOrWhiteSpace(application.CVLink))
                                {
                                    <a href="@application.CVLink"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="mw-btn mw-btn-outline">

                                        <span class="material-symbols-outlined">
                                            description
                                        </span>

                                        View CV

                                    </a>
                                }
                                else
                                {
                                    <span class="mw-muted">
                                        No CV
                                    </span>
                                }

                            </td>


                            @* Date *@
                            <td>
                                @application.Date.ToShortDateString()
                            </td>


                            @* Status *@
                            <td>

                                @if (application.Status == "Rejected")
                                {
                                    <span class="mw-status mw-status-rejected">
                                        Rejected
                                    </span>
                                }
                                else if (application.Status == "Accepted")
                                {
                                    <span class="mw-status mw-status-accepted">
                                        Accepted
                                    </span>
                                }
                                else if (application.Status == "Pending")
                                {
                                    <span class="mw-status mw-status-pending">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="mw-status mw-status-default">
                                        @application.Status
                                    </span>
                                }

                            </td>


                            @* Actions *@
                            <td>

                                <div class="d-flex gap-1 flex-wrap">

                                    <a class="mw-btn mw-btn-outline"
                                       asp-action="Details"
                                       asp-route-id="@application.Id">

                                        View

                                    </a>


                                    @if (application.Status == "Pending")
                                    {
                                        <form asp-action="Accept"
                                              asp-route-id="@application.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="mw-btn mw-btn-primary">

                                                <span class="material-symbols-outlined">
                                                    check
                                                </span>

                                                Accept

                                            </button>

                                        </form>


                                        <form asp-action="Reject"
                                              asp-route-id="@application.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="mw-btn mw-btn-outline">

                                                <span class="material-symbols-outlined">
                                                    close
                                                </span>

                                                Reject

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

</div>