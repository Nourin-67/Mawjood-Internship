@model List<BLogicLayer.ViewModels.ApplicationViewModel>
@{
    ViewData["Title"] = "Applications";
}

<div class="mw-container mw-section">
    <div class="mw-section-head">
        <div>
            <div class="mw-chip">Admin</div>
            <h2 class="mt-2">Applications Review</h2>
            <p>Review applications using the existing ApplicationController actions.</p>
        </div>
    </div>

    <div class="mw-card mw-table-wrap">
        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">
                <span class="material-symbols-outlined" style="font-size:42px;">inbox</span>
                <h3 class="mt-3">No applications found</h3>
            </div>
        }
        else
        {
            <table class="mw-table">
                <thead><tr><th>Applicant</th><th>Internship</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var application in Model)
                {
                    <tr>
                        <td><strong>@application.StudentName</strong></td>
                        <td>@application.InternshipTitle</td>
                        <td>@application.Date.ToShortDateString()</td>
                        <td>
                            @if (application.Status == "Rejected")
                            {
                                <span class="mw-status mw-status-rejected">Rejected</span>
                            }
                            else if (application.Status == "Accepted")
                            {
                                <span class="mw-status mw-status-accepted">Accepted</span>
                            }
                            else if (application.Status == "Pending")
                            {
                                <span class="mw-status mw-status-pending">@application.Status</span>
                            }
                            else
                            {
                                <span class="mw-status mw-status-default">@application.Status</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a class="mw-btn mw-btn-outline" asp-action="Details" asp-route-id="@application.Id">View</a>
                                @if (application.Status != "Rejected")
                                {
                                    <form asp-action="Reject" asp-route-id="@application.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="mw-btn mw-btn-outline">Reject</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
