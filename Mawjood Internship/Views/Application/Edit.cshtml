@using BLogicLayer.ViewModels
@model ApplicationViewModel

@{
    ViewData["Title"] = "Edit Application";
}

<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card shadow p-4">

            <h2>Edit Application</h2>

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div class="mb-3">

                    <label asp-for="StudentId"
                           class="form-label">
                        Student ID
                    </label>

                    <input asp-for="StudentId"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="InternshipId"
                           class="form-label">
                        Internship ID
                    </label>

                    <input asp-for="InternshipId"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Date"
                           class="form-label">
                    </label>

                    <input asp-for="Date"
                           type="date"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Status"
                           class="form-label">
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="Accepted">
                            Accepted
                        </option>

                        <option value="Rejected">
                            Rejected
                        </option>

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-warning">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>