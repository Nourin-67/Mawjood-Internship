@{
    ViewData["Title"] = "Home";
}
<h1 class="display-4 fw-bold">
    Mawjood Internship
</h1>

<p class="lead mt-3">
    Find internships, training opportunities and build your career.
</p>

@if (User.Identity != null &&
     User.Identity.IsAuthenticated)
{
    <a asp-controller="Internship"
       asp-action="Index"
       class="btn btn-primary btn-lg mt-3">
        Explore Internships
    </a>
}
else
{
    <a asp-controller="Account"
       asp-action="Register"
       class="btn btn-primary btn-lg mt-3">
        Get Started
    </a>

    <a asp-controller="Account"
       asp-action="Login"
       class="btn btn-outline-dark btn-lg mt-3">
        Login
    </a>
}