@model BLogicLayer.ViewModels.InternshipViewModel
@{
    ViewData["Title"] = "Internship Details";
}

<div class="mw-container mw-section">
    <a class="mw-muted" asp-action="Index">← Back to internships</a>

    <div class="mw-card mw-detail mt-3">
        <span class="mw-chip">@Model.Location</span>
        <h1 class="mt-3">@Model.Title</h1>
        <p class="mw-muted mb-0">@Model.CompanyName</p>

        <div class="mw-detail-section mt-4">
            <h2>Internship Details</h2>
            <div class="mw-info-grid">
                <div class="mw-info-item">
                    <div class="mw-info-label">Title</div>
                    <div class="mw-info-value">@Model.Title</div>
                </div>
                <div class="mw-info-item">
                    <div class="mw-info-label">Location</div>
                    <div class="mw-info-value">@Model.Location</div>
                </div>
                <div class="mw-info-item">
                    <div class="mw-info-label">Company</div>
                    <div class="mw-info-value">@Model.CompanyName</div>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="mw-actions-row">
                <a class="mw-btn mw-btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit Internship</a>
                <a class="mw-btn mw-btn-outline" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
            </div>
        }
        else
        {
            <div class="mw-detail-section">
                <div class="mw-card mw-card-pad" style="background:#f5f8ff;border-color:#dbe6ff;">
                    <strong>Interested in this opportunity?</strong>
                    <p class="mw-muted mb-0 mt-1">
                        Your current backend does not expose a student application-create action, so this page intentionally does not show a fake Apply button.
                    </p>
                </div>
            </div>
        }
    </div>
</div>
