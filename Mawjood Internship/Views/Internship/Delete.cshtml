@model BLogicLayer.ViewModels.InternshipViewModel

@{
    ViewData["Title"] = "Delete Internship";
}

<div class="container mw-container py-5">

    <div class="mw-card mw-card-pad mx-auto"
         style="max-width: 650px;">

        <div class="text-center mb-4">

            <div class="mw-auth-icon mb-3">
                <span class="material-symbols-outlined">
                    delete
                </span>
            </div>

            <h1 class="fw-bold">
                Delete Internship
            </h1>

            <p class="mw-muted">
                Are you sure you want to delete this internship?
            </p>

        </div>


        <div class="mw-info-grid mb-4">

            <div class="mw-info-item">

                <div class="mw-info-label">
                    Internship Title
                </div>

                <div class="mw-info-value">
                    @Model.Title
                </div>

            </div>


            <div class="mw-info-item">

                <div class="mw-info-label">
                    Location
                </div>

                <div class="mw-info-value">
                    @Model.Location
                </div>

            </div>


            <div class="mw-info-item">

                <div class="mw-info-label">
                    Company
                </div>

                <div class="mw-info-value">
                    @Model.CompanyName
                </div>

            </div>

        </div>


        <div class="alert alert-warning">
            <strong>Warning:</strong>
            This action cannot be undone.
        </div>


        <form asp-controller="Internship"
              asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div class="d-flex gap-2 justify-content-end mt-4">

                <a asp-controller="Internship"
                   asp-action="Index"
                   class="btn mw-btn mw-btn-outline">

                    Cancel

                </a>


                <button type="submit"
                        class="btn mw-btn"
                        style="background:#dc3545; color:white;">

                    <span class="material-symbols-outlined">
                        delete
                    </span>

                    Delete Internship

                </button>

            </div>

        </form>

    </div>

</div>