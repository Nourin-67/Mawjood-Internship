@model BLogicLayer.ViewModels.InternshipViewModel

@{
    ViewData["Title"] = "Delete Internship";
}

<div class="container mt-4">

    <h2>Delete Internship</h2>

    <div class="alert alert-danger">
        Are you sure you want to delete this internship?
    </div>

    <div class="card p-4">

        <h4>@Model.Title</h4>

        <p>
            <strong>Location:</strong>
            @Model.Location
        </p>

        <p>
            <strong>Company:</strong>
            @Model.CompanyName
        </p>

    </div>

    <form asp-action="DeleteConfirmed"
          method="post"
          class="mt-3">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.Id" />

        <button type="submit"
                class="btn btn-danger">
            Yes, Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>