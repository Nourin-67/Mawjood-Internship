@model List<BLogicLayer.ViewModels.InternshipViewModel>

@{
    ViewData["Title"] = "Internships";
}

<div class="mw-container mw-section">

    <!-- Page Header -->
    <div class="mw-section-head">

        <div>
            <div class="mw-chip">
                Opportunities
            </div>

            <h2 class="mt-2">
                Browse Internships
            </h2>

            <p>
                Explore the internship opportunities currently available in Mawjood.
            </p>
        </div>


        <!-- Add Internship - Admin Only -->
        @if (User.IsInRole("Admin"))
        {
            <a class="mw-btn mw-btn-primary"
               asp-action="Create">

                <span class="material-symbols-outlined">
                    add
                </span>

                Add Internship

            </a>
        }

    </div>


    <!-- Empty State -->
    @if (Model == null || !Model.Any())
    {
        <div class="mw-card mw-empty">

            <span class="material-symbols-outlined"
                  style="font-size:42px;">

                work_outline

            </span>

            <h3 class="mt-3">
                No internships available
            </h3>

            <p>
                There are currently no internship opportunities to display.
            </p>

        </div>
    }
    else
    {
        <!-- Internship Cards -->
        <div class="mw-grid">

            @foreach (var internship in Model)
            {
                <article class="mw-card mw-internship-card">

                    <!-- Location -->
                    <span class="mw-chip">
                        @internship.Location
                    </span>


                    <!-- Title -->
                    <h3 class="mt-3">
                        @internship.Title
                    </h3>


                    <!-- Company -->
                    <div class="mw-muted">
                        @internship.CompanyName
                    </div>


                    <!-- Actions -->
                    <div class="mw-actions-row">

                        <!-- Details -->
                        <a class="mw-btn mw-btn-primary"
                           asp-action="Details"
                           asp-route-id="@internship.Id">

                            View Details

                        </a>


                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Edit -->
                            <a class="mw-btn mw-btn-outline"
                               asp-action="Edit"
                               asp-route-id="@internship.Id">

                                Edit

                            </a>


                            <!-- Delete -->
                            <form asp-action="Delete"
                                  asp-route-id="@internship.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="mw-btn mw-btn-outline"
                                        onclick="return confirm('Are you sure you want to delete this internship?');">

                                    Delete

                                </button>

                            </form>
                        }

                    </div>

                </article>
            }

        </div>
    }

</div>