@model BLogicLayer.ViewModels.InternshipBrowseViewModel

@{
    ViewData["Title"] = "Internships";
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Internships</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                + Add Internship
            </a>
        }
    </div>

    @if (User.IsInRole("Student"))
    {
        <div class="mb-5">
            <h3 class="mb-3">
                Recommended Internships
            </h3>

            @if (!Model.RecommendedInternships.Any())
            {
                <div class="alert alert-info">
                    No internships currently match your skills.
                    Add more skills to your CV to get recommendations.
                </div>
            }
            else
            {
                <div class="row">

                    @foreach (var internship
                        in Model.RecommendedInternships)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">

                            <div class="card h-100 shadow-sm">

                                <div class="card-body">

                                    <h5 class="card-title">
                                        @internship.Title
                                    </h5>

                                    <p class="text-muted mb-2">
                                        @internship.CompanyName
                                    </p>

                                    <p>
                                        <strong>Location:</strong>
                                        @internship.Location
                                    </p>

                                    <p>
                                        <strong>Skill Match:</strong>
                                        @internship.MatchingSkills /
                                        @internship.TotalSkills
                                        (@internship.MatchPercentage%)
                                    </p>

                                    @if (internship.Skills.Any())
                                    {
                                        <p>
                                            <strong>Required Skills:</strong>
                                            @string.Join(", ", internship.Skills)
                                        </p>
                                    }

                                    @if (internship.HasApplied)
                                    {
                                        <span class="badge
                                            @(internship.ApplicationStatus == "Accepted"
                                                ? "bg-success"
                                                : internship.ApplicationStatus == "Rejected"
                                                    ? "bg-danger"
                                                    : "bg-warning text-dark")">

                                            @internship.ApplicationStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-controller="Application"
                                              asp-action="Apply"
                                              method="post"
                                              class="mt-3">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="internshipId"
                                                   value="@internship.Id" />

                                            <button type="submit"
                                                    class="btn btn-primary w-100">
                                                Apply
                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
        </div>
    }

    <div>

        <h3 class="mb-3">
            All Internships
        </h3>

        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Title</th>
                        <th>Location</th>
                        <th>Company</th>

                        @if (User.IsInRole("Admin"))
                        {
                            <th>Actions</th>
                        }
                    </tr>

                </thead>

                <tbody>

                    @foreach (var internship
                        in Model.AllInternships)
                    {
                        <tr>

                            <td>
                                @internship.Title
                            </td>

                            <td>
                                @internship.Location
                            </td>

                            <td>
                                @internship.CompanyName
                            </td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@internship.Id"
                                       class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@internship.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@internship.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>