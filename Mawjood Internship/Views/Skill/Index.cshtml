@model List<BLogicLayer.ViewModels.SkillViewModel>
@{
    ViewData["Title"] = "Skills";
}

<div class="mw-container mw-section">
    <div class="mw-section-head">
        <div>
            <div class="mw-chip">Admin</div>
            <h2 class="mt-2">Skills Management</h2>
            <p>Manage the skills available in the existing system.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a class="mw-btn mw-btn-primary" asp-action="Create">
                <span class="material-symbols-outlined">add</span> Add Skill
            </a>
        }
    </div>

    <div class="mw-card mw-card-pad">
        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">No skills found.</div>
        }
        else
        {
            <div class="mw-grid" style="grid-template-columns:repeat(3,minmax(0,1fr));">
                @foreach (var skill in Model)
                {
                    <div class="mw-card mw-card-pad">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <strong>@skill.Name</strong>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-1">
                                    <a class="mw-btn mw-btn-outline" asp-action="Edit" asp-route-id="@skill.Id">Edit</a>
                                    <a class="mw-btn mw-btn-outline" asp-action="Delete" asp-route-id="@skill.Id">Delete</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
