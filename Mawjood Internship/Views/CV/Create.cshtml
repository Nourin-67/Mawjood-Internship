@model BLogicLayer.ViewModels.CVViewModel

@{
    ViewData["Title"] = "My CV";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">My CV</h1>
        <p class="text-muted">
            Upload your CV or add an external CV link.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>


    <!-- ========================================= -->
    <!-- EXISTING UPLOADED CV -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.CVFilePath))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="fw-bold">
                    <i class="bi bi-file-earmark-pdf"></i>
                    Uploaded CV
                </h5>

                <p class="text-muted">
                    Your uploaded PDF is already available.
                </p>

                <div class="d-flex gap-2">

                    <a href="@Model.CVFilePath"
                       target="_blank"
                       class="btn btn-primary">

                        <i class="bi bi-eye"></i>
                        View CV

                    </a>

                    <a href="@Model.CVFilePath"
                       download
                       class="btn btn-outline-secondary">

                        <i class="bi bi-download"></i>
                        Download CV

                    </a>

                </div>

            </div>
        </div>
    }


    <!-- ========================================= -->
    <!-- EXISTING EXTERNAL CV -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.ExternalCVLink))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="fw-bold">
                    <i class="bi bi-link-45deg"></i>
                    External CV
                </h5>

                <p class="text-muted">
                    Your external CV link is already saved.
                </p>

                <a href="@Model.ExternalCVLink"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-primary">

                    <i class="bi bi-box-arrow-up-right"></i>
                    Open External CV

                </a>

            </div>
        </div>
    }


    <!-- ========================================= -->
    <!-- CV FORM -->
    <!-- ========================================= -->

    <div class="card shadow-sm">

        <div class="card-body p-4">

            <form asp-action="SaveCV"
                  asp-controller="CV"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <!-- ================================= -->
                <!-- PERSONAL INFORMATION -->
                <!-- ================================= -->

                <h4 class="fw-bold mb-3">
                    Personal Information
                </h4>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="FName"
                               class="form-label">
                            First Name
                        </label>

                        <input asp-for="FName"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="LName"
                               class="form-label">
                            Last Name
                        </label>

                        <input asp-for="LName"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <div class="mb-4">

                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           readonly />

                </div>


                <!-- ================================= -->
                <!-- UPLOAD PDF -->
                <!-- ================================= -->

                <h4 class="fw-bold mb-3">
                    Upload CV
                </h4>

                <div class="mb-4">

                    <label asp-for="CVFile"
                           class="form-label">
                        CV PDF File
                    </label>

                    <input asp-for="CVFile"
                           type="file"
                           class="form-control"
                           accept=".pdf,application/pdf" />

                    <div class="form-text">
                        Only PDF files are allowed.
                        Maximum size: 5 MB.
                    </div>

                    <span asp-validation-for="CVFile"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================= -->
                <!-- EXTERNAL LINK -->
                <!-- ================================= -->

                <h4 class="fw-bold mb-3">
                    External CV
                </h4>

                <div class="mb-4">

                    <label asp-for="ExternalCVLink"
                           class="form-label">
                        External CV Link
                    </label>

                    <input asp-for="ExternalCVLink"
                           type="url"
                           class="form-control"
                           placeholder="https://drive.google.com/..." />

                    <div class="form-text">
                        You can add a Google Drive,
                        OneDrive, Dropbox or other CV link.
                    </div>

                    <span asp-validation-for="ExternalCVLink"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================= -->
                <!-- INTERNAL CV -->
                <!-- ================================= -->

                <hr class="my-4" />

                <h4 class="fw-bold mb-3">
                    Internal CV Information
                </h4>

                <div class="mb-3">

                    <label asp-for="AboutMe"
                           class="form-label">
                        About Me
                    </label>

                    <textarea asp-for="AboutMe"
                              class="form-control"
                              rows="4"
                              placeholder="Tell companies about yourself...">
                    </textarea>

                    <span asp-validation-for="AboutMe"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Skills"
                           class="form-label">
                        Skills
                    </label>

                    <textarea asp-for="Skills"
                              class="form-control"
                              rows="4"
                              placeholder="C#, Python, SQL, Cybersecurity...">
                    </textarea>

                    <span asp-validation-for="Skills"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Courses"
                           class="form-label">
                        Courses
                    </label>

                    <textarea asp-for="Courses"
                              class="form-control"
                              rows="4"
                              placeholder="Courses and certificates...">
                    </textarea>

                    <span asp-validation-for="Courses"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Experience"
                           class="form-label">
                        Experience
                    </label>

                    <textarea asp-for="Experience"
                              class="form-control"
                              rows="4"
                              placeholder="Internships, projects, experience...">
                    </textarea>

                    <span asp-validation-for="Experience"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================= -->
                <!-- BUTTONS -->
                <!-- ================================= -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Save CV

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}