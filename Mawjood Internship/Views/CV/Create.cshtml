@model BLogicLayer.ViewModels.CVViewModel

@{
    ViewData["Title"] = "Create / Edit CV";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5">

                    <h2 class="fw-bold mb-4">
                        Create / Edit My CV
                    </h2>

                    <form asp-action="SaveInternalCV"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <h4 class="border-bottom pb-2 mb-4">
                            Personal Information
                        </h4>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FName"
                                       class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FName"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="LName"
                                       class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LName"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-12 mb-3">

                                <label asp-for="Email"
                                       class="form-label">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>

                        <h4 class="border-bottom pb-2 mb-4 mt-4">
                            Education
                        </h4>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="University"
                                       class="form-label">
                                    University
                                </label>

                                <input asp-for="University"
                                       class="form-control" />

                                <span asp-validation-for="University"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Major"
                                       class="form-label">
                                    Major
                                </label>

                                <input asp-for="Major"
                                       class="form-control" />

                                <span asp-validation-for="Major"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="AcademicYear"
                                       class="form-label">
                                    Academic Year
                                </label>

                                <select asp-for="AcademicYear"
                                        class="form-select">

                                    <option value="">
                                        Select Year
                                    </option>

                                    <option value="1">
                                        1
                                    </option>

                                    <option value="2">
                                        2
                                    </option>

                                    <option value="3">
                                        3
                                    </option>

                                    <option value="4">
                                        4
                                    </option>

                                    <option value="5">
                                        5
                                    </option>

                                </select>

                                <span asp-validation-for="AcademicYear"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Education"
                                       class="form-label">
                                    Education
                                </label>

                                <input asp-for="Education"
                                       class="form-control" />

                                <span asp-validation-for="Education"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <h4 class="border-bottom pb-2 mb-4 mt-4">
                            Location
                        </h4>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="City"
                                       class="form-label">
                                    City
                                </label>

                                <input asp-for="City"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Government"
                                       class="form-label">
                                    Government
                                </label>

                                <input asp-for="Government"
                                       class="form-control" />

                            </div>

                        </div>

                        <h4 class="border-bottom pb-2 mb-4 mt-4">
                            CV Information
                        </h4>

                        <div class="mb-3">

                            <label asp-for="AboutMe"
                                   class="form-label">
                                About Me
                            </label>

                            <textarea asp-for="AboutMe"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="AboutMe"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Skills"
                                   class="form-label">
                                Skills
                            </label>

                            <textarea asp-for="Skills"
                                      class="form-control"
                                      rows="4"
                                      placeholder="C#, SQL, HTML, CSS"></textarea>

                            <small class="text-muted">
                                Separate skills using commas.
                            </small>

                            <span asp-validation-for="Skills"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Courses"
                                   class="form-label">
                                Courses & Certificates
                            </label>

                            <textarea asp-for="Courses"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Courses"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Experience"
                                   class="form-label">
                                Experience
                            </label>

                            <textarea asp-for="Experience"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Experience"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Save CV
                        </button>

                    </form>

                    <hr class="my-5" />

                    <h4>
                        External CV
                    </h4>

                    <p class="text-muted">
                        You can also save a link to your CV.
                    </p>

                    <form asp-action="SaveExternalCV"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="input-group">

                            <input type="url"
                                   name="cvLink"
                                   class="form-control"
                                   placeholder="https://example.com/my-cv"
                                   required />

                            <button type="submit"
                                    class="btn btn-primary">
                                Save CV Link
                            </button>

                        </div>

                    </form>

                    <a asp-action="Index"
                       class="btn btn-secondary mt-3 w-100">
                        Back to My CV
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}