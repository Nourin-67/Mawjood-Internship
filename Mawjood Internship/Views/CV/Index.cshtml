@model BLogicLayer.ViewModels.CVViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">
            @Model.FName @Model.LName
        </h1>

        <p class="text-muted">
            @Model.Email
        </p>
    </div>


    <!-- ========================================= -->
    <!-- CV FILE -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.CVFilePath))
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h4 class="fw-bold">
                    <i class="bi bi-file-earmark-pdf"></i>
                    My CV File
                </h4>

                <p class="text-muted">
                    Your uploaded PDF CV.
                </p>

                <div class="d-flex gap-2">

                    <a href="@Model.CVFilePath"
                       target="_blank"
                       class="btn btn-primary">

                        <i class="bi bi-eye"></i>
                        Preview

                    </a>

                    <a href="@Model.CVFilePath"
                       download
                       class="btn btn-outline-primary">

                        <i class="bi bi-download"></i>
                        Download

                    </a>

                </div>

            </div>

        </div>
    }


    <!-- ========================================= -->
    <!-- EXTERNAL CV -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.ExternalCVLink))
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h4 class="fw-bold">
                    <i class="bi bi-link-45deg"></i>
                    External CV
                </h4>

                <p class="text-muted">
                    CV hosted on an external platform.
                </p>

                <a href="@Model.ExternalCVLink"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-success">

                    <i class="bi bi-box-arrow-up-right"></i>
                    Open CV Link

                </a>

            </div>

        </div>
    }


    <!-- ========================================= -->
    <!-- INTERNAL CV -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.AboutMe) ||
            !string.IsNullOrWhiteSpace(Model.Skills) ||
            !string.IsNullOrWhiteSpace(Model.Courses) ||
            !string.IsNullOrWhiteSpace(Model.Experience))
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h4 class="fw-bold mb-4">
                    Internal CV
                </h4>

                @if (!string.IsNullOrWhiteSpace(Model.AboutMe))
                {
                    <div class="mb-4">

                        <h5 class="fw-bold">
                            About Me
                        </h5>

                        <p>
                            @Model.AboutMe
                        </p>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Skills))
                {
                    <div class="mb-4">

                        <h5 class="fw-bold">
                            Skills
                        </h5>

                        <p>
                            @Model.Skills
                        </p>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Courses))
                {
                    <div class="mb-4">

                        <h5 class="fw-bold">
                            Courses
                        </h5>

                        <p>
                            @Model.Courses
                        </p>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Experience))
                {
                    <div class="mb-4">

                        <h5 class="fw-bold">
                            Experience
                        </h5>

                        <p>
                            @Model.Experience
                        </p>

                    </div>
                }

            </div>

        </div>
    }


    <!-- ========================================= -->
    <!-- EDIT CV -->
    <!-- ========================================= -->

    <a asp-action="Create"
       class="btn btn-dark">

        <i class="bi bi-pencil"></i>
        Edit CV

    </a>

</div>