@model BLogicLayer.ViewModels.CVViewModel

@{
    ViewData["Title"] = "My CV";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5">


                    <!-- ========================= -->
                    <!-- HEADER -->
                    <!-- ========================= -->

                    <div class="text-center mb-5">

                        <h1 class="fw-bold">

                            @Model.FName @Model.LName

                        </h1>

                        <p class="text-muted mb-1">

                            @Model.Email

                        </p>

                        @if (!string.IsNullOrWhiteSpace(Model.Major))
                        {
                            <p class="text-muted">

                                @Model.Major

                            </p>
                        }

                    </div>


                    <!-- ========================= -->
                    <!-- PERSONAL INFORMATION -->
                    <!-- ========================= -->

                    <h4 class="border-bottom pb-2 mb-4">

                        Personal Information

                    </h4>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <strong>
                                First Name
                            </strong>

                            <p>
                                @Model.FName
                            </p>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Last Name
                            </strong>

                            <p>
                                @Model.LName
                            </p>

                        </div>


                        <div class="col-md-12 mb-3">

                            <strong>
                                Email
                            </strong>

                            <p>
                                @Model.Email
                            </p>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- EDUCATION -->
                    <!-- ========================= -->

                    <h4 class="border-bottom pb-2 mb-4 mt-4">

                        Education

                    </h4>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <strong>
                                University
                            </strong>

                            <p>
                                @Model.University
                            </p>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Major
                            </strong>

                            <p>
                                @Model.Major
                            </p>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Academic Year
                            </strong>

                            <p>
                                @Model.AcademicYear
                            </p>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Education
                            </strong>

                            <p>
                                @Model.Education
                            </p>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- LOCATION -->
                    <!-- ========================= -->

                    <h4 class="border-bottom pb-2 mb-4 mt-4">

                        Location

                    </h4>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <strong>
                                City
                            </strong>

                            <p>
                                @Model.City
                            </p>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Government
                            </strong>

                            <p>
                                @Model.Government
                            </p>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- ABOUT ME -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.AboutMe))
                    {
                        <h4 class="border-bottom pb-2 mb-4 mt-4">

                            About Me

                        </h4>

                        <p style="white-space: pre-line;">

                            @Model.AboutMe

                        </p>
                    }


                    <!-- ========================= -->
                    <!-- SKILLS -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.Skills))
                    {
                        <h4 class="border-bottom pb-2 mb-4 mt-4">

                            Skills

                        </h4>

                        <p style="white-space: pre-line;">

                            @Model.Skills

                        </p>
                    }


                    <!-- ========================= -->
                    <!-- COURSES -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.Courses))
                    {
                        <h4 class="border-bottom pb-2 mb-4 mt-4">

                            Courses & Certificates

                        </h4>

                        <p style="white-space: pre-line;">

                            @Model.Courses

                        </p>
                    }


                    <!-- ========================= -->
                    <!-- EXPERIENCE -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.Experience))
                    {
                        <h4 class="border-bottom pb-2 mb-4 mt-4">

                            Experience

                        </h4>

                        <p style="white-space: pre-line;">

                            @Model.Experience

                        </p>
                    }


                    <!-- ========================= -->
                    <!-- EXTERNAL CV -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(
                                            Model.ExistingCVLink))
                    {
                        <div class="mt-5">

                            <a href="@Model.ExistingCVLink"
                               target="_blank"
                               class="btn btn-primary w-100">

                                Open My CV Link

                            </a>

                        </div>
                    }


                    <!-- ========================= -->
                    <!-- EDIT -->
                    <!-- ========================= -->

                    <div class="mt-3">

                        <a asp-action="Create"
                           class="btn btn-outline-primary w-100">

                            Edit My CV

                        </a>

                    </div>


                </div>

            </div>

        </div>

    </div>

</div>